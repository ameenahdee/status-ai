AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PORT=3001

# Global cap on live AI generations per UTC day (protects the shared free quota). Default 200.
DAILY_REQUEST_CAP=200

# Live generation sends visitor text to Google. When NODE_ENV=production it is OFF unless this is
# set to true; outside production (local development) it is on by default.
# LIVE_GENERATION_ENABLED=true
